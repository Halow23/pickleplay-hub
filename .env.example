# PicklePlay environment configuration
# Copy to .env and fill in real values before running the server.

# --- Required in all environments ---

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 16 characters; the server refuses to boot otherwise.
JWT_SECRET=

# --- Required in production (validated at boot) ---

# MySQL connection string, e.g.
# mysql://user:password@localhost:3306/pickleplay
DATABASE_URL=

# Manus OAuth server that issues session tokens after login.
OAUTH_SERVER_URL=

# --- Optional ---

# openId of the project owner; this account is auto-promoted to admin on
# every login and cannot be sanctioned.
OWNER_OPEN_ID=

# Manus app id used by the client runtime.
VITE_APP_ID=

# Built-in Forge API (only used by the hosted preview runtime).
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Optional: email notifications ---

# SMTP connection string (e.g. smtps://user:pass@smtp.provider.com:465).
# When unset, email notifications are suppressed and only in-app delivery runs.
SMTP_URL=

# From address for outgoing notification email, e.g. "PicklePlay <no-reply@pickleplay.example>".
EMAIL_FROM=

# Port the server listens on (defaults to 3000).
# PORT=3000
